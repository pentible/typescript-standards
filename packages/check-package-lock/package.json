{
    "name": "@pentible/check-package-lock",
    "version": "0.121.0",
    "description": "command to verify a package-lock.json is in sync with its package.json",
    "repository": {
        "type": "git",
        "url": "https://github.com/pentible/typescript-standards.git"
    },
    "license": "MIT",
    "author": "pentible",
    "type": "module",
    "imports": {
        "#/*": "./src/*.ts"
    },
    "exports": {
        ".": "./src/main.ts"
    },
    "bin": {
        "check-package-lock": "./src/main.ts"
    },
    "files": [
        "dist/main.mjs"
    ],
    "scripts": {
        "build": "tsdown --logLevel 'warn'",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@npmcli/arborist": "10.0.1",
        "@types/node": "24.13.3",
        "@types/npmcli__arborist": "6.3.3",
        "@types/yargs": "17.0.35",
        "chalk": "5.4.1",
        "execa": "8.0.1",
        "tsdown": "0.22.14",
        "yargs": "18.0.0",
        "zod": "3.25.65"
    },
    "engines": {
        "node": ">=24"
    },
    "publishConfig": {
        "access": "public",
        "bin": {
            "check-package-lock": "./dist/main.mjs"
        }
    }
}
