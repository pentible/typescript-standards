{
    "$schema": "./node_modules/turbo/schema.json",
    "envMode": "loose",
    "concurrency": "12",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "typecheck": {
            "outputLogs": "errors-only",
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/packages/tsconfig/tsconfig.json"
            ]
        },
        "//#typecheck:root": {
            "outputLogs": "errors-only",
            "inputs": ["tsconfig.json", "*.config.mjs"]
        },
        "lint": {
            "outputLogs": "errors-only",
            "with": ["lint:eslint", "lint:prettier"],
            "dependsOn": ["//#lint:root"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"]
        },
        "//#lint:root": {
            "outputLogs": "errors-only",
            "with": [
                "lint:eslint:root",
                "lint:prettier:root",
                "lint:package-lock",
                "lint:shellcheck",
                "lint:yaml"
            ],
            "inputs": ["*.config.mjs"]
        },
        "lint:eslint": { "outputLogs": "errors-only" },
        "//#lint:eslint:root": { "outputLogs": "errors-only" },
        "lint:prettier": { "outputLogs": "errors-only" },
        "//#lint:prettier:root": {
            "outputLogs": "errors-only"
        },
        "//#lint:package-lock": {
            "outputLogs": "errors-only",
            "inputs": ["package.json", "**/package.json", "package-lock.json"]
        },
        "//#lint:shellcheck": {
            "outputLogs": "errors-only",
            "inputs": ["bin/*", ".husky/*"]
        },
        "//#lint:yaml": {
            "outputLogs": "errors-only",
            "inputs": ["**/*.yml"]
        }
    }
}
